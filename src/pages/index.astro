---

 import Layout from "../layouts/Layout.astro";
---
<Layout title="Inicio">
  <main class="min-h-[80vh] flex items-center px-6 py-16">
    <section class="max-w-6xl mx-auto w-full">


  <div class="grid md:grid-cols-2 gap-12 items-center">

    <!-- Contenido principal -->
    <div>
      <p class="text-blue-600 font-semibold tracking-widest uppercase text-sm mb-5">
        Bienvenido a mi espacio digital
      </p>

      <h1 class="text-5xl md:text-7xl font-black leading-tight mb-6">
        Ideas,
        <span class="text-blue-600">código</span>
        y tecnología.
      </h1>

      <p class="text-lg text-gray-600 leading-8 max-w-xl mb-8">
        Este es mi blog personal, un lugar donde documento lo que aprendo,
        comparto proyectos y escribo sobre programación, desarrollo web y
        las tecnologías que despiertan mi curiosidad.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/blog"
          class="bg-gray-900 text-white px-7 py-3 rounded-lg font-semibold
                 hover:bg-blue-600 transition"
        >
          Entrar al blog →
        </a>

        <a
          href="/about"
          class="border border-gray-300 px-7 py-3 rounded-lg font-semibold
                 hover:border-blue-600 hover:text-blue-600 transition"
        >
          Conóceme
        </a>
      </div>
    </div>

    <!-- Elemento visual -->
    <div class="relative">
      <div
        class="bg-gray-900 rounded-2xl p-6 shadow-2xl
               rotate-2 hover:rotate-0 transition duration-500"
      >
        <div class="flex gap-2 mb-6">
          <span class="w-3 h-3 rounded-full bg-red-400"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
          <span class="w-3 h-3 rounded-full bg-green-400"></span>
        </div>

        <div class="font-mono text-sm md:text-base leading-8">
          <p class="text-gray-500">// Mi blog</p>

          <p>
            <span class="text-purple-400">const</span>
            <span class="text-blue-300"> aprendizaje</span>
            =
            <span class="text-green-300">"continuo"</span>;
          </p>

          <p>
            <span class="text-purple-400">const</span>
            <span class="text-blue-300"> proyectos</span>
            =
            <span class="text-yellow-300">∞</span>;
          </p>

          <p class="mt-4 text-gray-400">
            &gt; creando, aprendiendo, compartiendo...
          </p>

          <p class="text-green-400">
            ✓ listo para comenzar
          </p>
        </div>
      </div>

      <div
        class="absolute -bottom-6 -left-6 bg-blue-600 text-white
               rounded-xl px-5 py-4 shadow-lg"
      >
        <p class="text-xs uppercase tracking-wider opacity-80">
          Actualmente
        </p>
        <p class="font-bold">
          Aprendiendo y creando 🚀
        </p>
      </div>
    </div>

  </div>

  <!-- Frase inferior -->
  <div class="mt-20 border-t border-gray-200 pt-8 flex flex-col md:flex-row
              justify-between gap-4 text-sm text-gray-500">
    <p>
      Código · Tecnología · Aprendizaje
    </p>

    <p>
      Cada proyecto es una nueva oportunidad para aprender.
    </p>
  </div>

</section>


  </main>
</Layout>
