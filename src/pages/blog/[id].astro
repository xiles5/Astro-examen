---

import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
const posts = await getCollection("blog");

return posts.map((post) => ({
params: {
id: post.id,
},
props: {
post,
},
}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main class="max-w-4xl mx-auto px-6 py-12">


<!-- Cabecera del artículo -->
<header class="mb-10">

  <a
    href="/blog"
    class="inline-flex items-center text-sm font-medium text-blue-600
           hover:text-blue-800 transition mb-8"
  >
    ← Volver al blog
  </a>

  <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 mb-4">
    Artículo
  </p>

  <h1 class="text-4xl md:text-5xl font-bold leading-tight text-gray-900 mb-6">
    {post.data.title}
  </h1>

  <p class="text-xl text-gray-600 leading-8 mb-6">
    {post.data.description}
  </p>

  <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
    <span>
      ✍️ Por <strong class="text-gray-700">{post.data.author}</strong>
    </span>

    <span class="text-gray-300">•</span>

    <time datetime={post.data.pubDate.toISOString()}>
      📅 {post.data.pubDate.toLocaleDateString("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric"
      })}
    </time>
  </div>

</header>

<!-- Línea decorativa -->
<div class="h-1 w-16 bg-blue-600 rounded-full mb-10"></div>

<!-- Contenido -->
<article
  class="prose prose-lg max-w-none
         prose-headings:text-gray-900
         prose-headings:font-bold
         prose-p:text-gray-700
         prose-p:leading-8
         prose-a:text-blue-600
         prose-a:no-underline
         hover:prose-a:underline
         prose-strong:text-gray-900
         prose-li:text-gray-700"
>
  <Content />
</article>

<!-- Final del artículo -->
<footer class="mt-16 pt-8 border-t border-gray-200">

  <div class="bg-gray-50 rounded-2xl p-6 flex flex-col sm:flex-row
              items-start sm:items-center justify-between gap-5">

    <div>
      <p class="font-bold text-gray-900 mb-1">
        ¿Quieres seguir leyendo?
      </p>

      <p class="text-sm text-gray-600">
        Descubre más artículos en mi blog.
      </p>
    </div>

    <a
      href="/blog"
      class="bg-blue-600 text-white px-6 py-3 rounded-lg
             font-semibold hover:bg-blue-700 transition whitespace-nowrap"
    >
      Ver más artículos →
    </a>

  </div>

</footer>


  </main>
</Layout>
